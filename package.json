{
  "name": "skybook",
  "version": "1.0.0",
  "private": true,
  "description": "SkyBook — full-stack flight booking platform",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix server && npm run lint --prefix client",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
